{
  "name": "expanso-chatgpt-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Expanso Fleet plugin for ChatGPT, built on the MCP TypeScript SDK and OpenAI MCP Extensions.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:app": "vite build --config app/vite.config.ts && node scripts/embed-app.mjs",
    "build": "npm run build:app && npm run build:worker",
    "build:plugin": "node scripts/build-plugin.mjs",
    "dev": "npm run build:app && wrangler dev",
    "deploy:pilot": "npm run build:app && node scripts/deploy-pilot.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run build:app && tsc --noEmit -p tsconfig.json && tsc --noEmit -p app/tsconfig.json",
    "test": "npm run build && vitest run",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "build:worker": "vite build --config worker.vite.config.ts"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.1",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@openai/mcp-extensions": "0.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260930.2",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "miniflare": "5.20260930.0-alpha",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.1.4",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.3",
    "wrangler": "4.145.0"
  },
  "allowScripts": {
    "workerd@1.20260930.2": true,
    "esbuild@0.28.1": true
  }
}
