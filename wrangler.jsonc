// Local development configuration. The pilot deployment writes its own
// wrangler.pilot.jsonc (gitignored) with real account and namespace IDs.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "expanso-fleet-mcp-dev",
  "main": "dist/worker/worker.js",
  "no_bundle": true,
  "build": { "command": "npm run build:worker" },
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "local-dev-oauth-kv" }],
  "observability": { "enabled": true },
}
