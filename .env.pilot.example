# Copy to .env.pilot (gitignored) and make it owner-only: chmod 600 .env.pilot
# A Cloudflare API token scoped to one account with exactly:
#   Account > Workers Scripts: Edit
#   Account > Workers KV Storage: Edit
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Optional. Defaults to expanso-fleet-chatgpt-pilot.
PILOT_WORKER_NAME=
